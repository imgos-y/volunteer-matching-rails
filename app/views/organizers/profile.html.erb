<h1 class="mb-4">My Profile</h1>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="mb-3">
          <small class="text-muted d-block">Name</small>
          <span class="fs-5"><%= @organizer.name %> <%= @organizer.name %></span>
        </div>

        <div class="mb-3">
          <small class="text-muted d-block">Email</small>
          <span class="fs-5"><%= @organizer.email %></span>
        </div>

        <div class="mb-3">
          <small class="text-muted d-block">Events Created</small>
          <span class="fs-5"><%= @organizer.events.count %></span>
        </div>

        <hr>

        <%= link_to "Edit Profile", edit_organizer_registration_path, class: "btn btn-outline-primary btn-sm" %>
        <%= link_to "Go to Dashboard", organizer_dashboard_path, class: "btn btn-outline-primary btn-sm" %>
      </div>
    </div>
  </div>
</div>