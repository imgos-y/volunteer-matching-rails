<div class="page-header">
  <h1>Badges</h1>
  <%= link_to "Create New Badge", new_badge_path, class: "button" %>
</div>

<% if @badges.empty? %>
  <p class="empty-state">No badges defined yet.</p>
<% else %>
  <div class="card-grid">
    <% @badges.each do |badge| %>
      <article class="panel stat">
        <h2 class="panel__title"><%= badge.name %></h2>
        <p class="stat__value"><%= badge.required_points %></p>
        <p class="stat__label">points required</p>
      </article>
    <% end %>
  </div>
<% end %>
