<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="card-title mb-4">Organizer Log in</h2>

        <%= form_with url: organizers_session_path do |f| %>
          <div class="mb-3">
            <%= f.label :email_address, "Email", class: "form-label" %>
            <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                              value: params[:email_address], class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, required: true, autocomplete: "current-password",
                                 maxlength: 72, class: "form-control" %>
          </div>

          <div class="d-grid">
            <%= f.submit "Log in", class: "btn btn-primary" %>
          </div>
        <% end %>

        <div class="mt-3">
          <%= link_to "Sign up", new_organizers_registration_path %><br>
          <%= link_to "Forgot your password?", new_password_path %>
        </div>
      </div>
    </div>
  </div>
</div>
