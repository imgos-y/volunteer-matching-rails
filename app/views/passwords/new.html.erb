<section class="panel panel--narrow">
  <h2 class="panel__title">Forgot your password?</h2>

  <%= form_with url: passwords_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                           value: params[:email_address], class: "input" %>
    </div>

    <%= form.submit "Email reset instructions", class: "button button--block" %>
  <% end %>
</section>
