<h1>Event Feedbacks</h1>

<% if @feedbacks.empty? %>
  <p class="empty-state">No feedback yet.</p>
<% else %>
  <div class="stack">
    <% @feedbacks.each do |feedback| %>
      <article class="panel event-card">
        <h2 class="event-card__title"><%= feedback.event.name %></h2>
        <p class="rating" aria-label="<%= feedback.rating %> out of 5">
          <%= "★" * feedback.rating %><%= "☆" * (5 - feedback.rating) %>
        </p>
        <p class="event-card__meta">
          By <%= feedback.volunteer.name %> <%= feedback.volunteer.surname %> ·
          <%= feedback.created_at.strftime("%d.%m.%Y %H:%M") %>
        </p>
        <p class="event-card__description"><%= feedback.comment %></p>
      </article>
    <% end %>
  </div>
<% end %>
