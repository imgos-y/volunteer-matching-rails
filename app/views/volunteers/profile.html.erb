<h1 class="mb-4">My Profile</h1>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="mb-3">
          <small class="text-muted d-block">Name</small>
          <span class="fs-5"><%= @volunteer.name %> <%= @volunteer.surname %></span>
        </div>

        <div class="mb-3">
          <small class="text-muted d-block">Email</small>
          <span class="fs-5"><%= @volunteer.email %></span>
        </div>

        <div class="mb-3">
          <small class="text-muted d-block">Skill</small>
          <span class="badge bg-secondary"><%= @volunteer.skill %></span>
        </div>

        <div class="mb-3">
          <small class="text-muted d-block">Interest</small>
          <span class="badge bg-info text-dark"><%= @volunteer.interest %></span>
        </div>

        <hr>

        <%= link_to "Edit Profile", edit_volunteer_registration_path, class: "btn btn-outline-primary btn-sm" %>
        <%= link_to "My Points", volunteer_points_path, class: "btn btn-outline-primary btn-sm" %>
      </div>
    </div>
  </div>
</div>