<section class="hero">
  <h1 class="hero__title">Volunteer Match</h1>
  <p class="hero__lead">
    Connecting volunteers with the events that matter to them — matched by skill and interest.
  </p>

  <div class="hero__actions">
    <% if current_volunteer %>
      <%= link_to "View Events", events_path, class: "button button--large" %>
    <% elsif current_organizer %>
      <%= link_to "Go to Dashboard", organizer_dashboard_path, class: "button button--large" %>
    <% else %>
      <%= link_to "I'm a Volunteer", new_volunteers_session_path, class: "button button--large" %>
      <%= link_to "I'm an Organizer", new_organizers_session_path, class: "button button--secondary button--large" %>
    <% end %>
  </div>
</section>

<section class="feature-grid">
  <article class="feature">
    <h2 class="feature__title">Smart Matching</h2>
    <p class="feature__text">Events are ranked by how well they match your skills and interests.</p>
  </article>

  <article class="feature">
    <h2 class="feature__title">Earn Badges</h2>
    <p class="feature__text">Collect points for every confirmed attendance and unlock badges.</p>
  </article>

  <article class="feature">
    <h2 class="feature__title">Stay Notified</h2>
    <p class="feature__text">Get notified about registrations, cancellations, and capacity updates.</p>
  </article>
</section>
