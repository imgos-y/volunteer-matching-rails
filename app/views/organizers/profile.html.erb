<h1>My Profile</h1>

<section class="panel panel--narrow">
  <dl class="details">
    <div>
      <dt>Name</dt>
      <dd><%= @organizer.name %></dd>
    </div>

    <div>
      <dt>Email</dt>
      <dd><%= @organizer.email_address %></dd>
    </div>

    <div>
      <dt>Events Created</dt>
      <dd><%= @organizer.events.count %></dd>
    </div>
  </dl>

  <div class="panel__actions">
    <%= link_to "Edit Profile", edit_organizers_registration_path, class: "button button--secondary button--small" %>
    <%= link_to "Go to Dashboard", organizer_dashboard_path, class: "button button--secondary button--small" %>
  </div>
</section>
