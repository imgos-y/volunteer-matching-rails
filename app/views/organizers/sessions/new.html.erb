<section class="panel panel--narrow">
  <h2 class="panel__title">Organizer Log in</h2>

  <%= form_with url: organizers_session_path do |f| %>
    <div class="field">
      <%= f.label :email_address, "Email" %>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
                        value: params[:email_address], class: "input" %>
    </div>

    <div class="field">
      <%= f.label :password %>
      <%= f.password_field :password, required: true, autocomplete: "current-password",
                           maxlength: 72, class: "input" %>
    </div>

    <%= f.submit "Log in", class: "button button--block" %>
  <% end %>

  <div class="panel__footer">
    <%= link_to "Sign up", new_organizers_registration_path %>
    <%= link_to "Forgot your password?", new_password_path %>
  </div>
</section>
