<h1>My Points</h1>

<section class="panel panel--narrow stat">
  <h2 class="panel__title"><%= @volunteer.name %> <%= @volunteer.surname %></h2>

  <p class="stat__value"><%= @volunteer.points %></p>
  <p class="stat__label">points</p>

  <% if @volunteer.badge %>
    <span class="tag tag--primary"><%= @volunteer.badge.name %></span>
  <% else %>
    <p class="stat__label">No badge yet</p>
  <% end %>
</section>
