<h1>My Profile</h1>

<section class="panel panel--narrow">
  <dl class="details">
    <div>
      <dt>Name</dt>
      <dd><%= @volunteer.name %> <%= @volunteer.surname %></dd>
    </div>

    <div>
      <dt>Email</dt>
      <dd><%= @volunteer.email_address %></dd>
    </div>

    <div>
      <dt>Skill</dt>
      <dd><span class="tag"><%= @volunteer.skill %></span></dd>
    </div>

    <div>
      <dt>Interest</dt>
      <dd><span class="tag tag--primary"><%= @volunteer.interest %></span></dd>
    </div>
  </dl>

  <div class="panel__actions">
    <%= link_to "Edit Profile", edit_volunteers_registration_path, class: "button button--secondary button--small" %>
    <%= link_to "My Points", volunteer_points_path, class: "button button--secondary button--small" %>
  </div>
</section>
