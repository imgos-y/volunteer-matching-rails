<!DOCTYPE html>
<html>
  <head>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Volunteer Matching">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Source+Serif+4:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "custom", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

  <%# "kayıt başarılı", "şifre yanlış" gibi flash message gösterebilmesi için  %>

  <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
      <%= link_to "Volunteer Match", root_path, class: "navbar-brand fw-bold" %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarContent">
        <div class="navbar-nav ms-auto">
        <% if volunteer_signed_in? %>
            <%= link_to current_volunteer.name, volunteer_profile_path, class: "nav-link " %>
          <%= link_to "Events", events_path, class: "nav-link" %>
          <%= link_to "My Events", my_events_path, class: "nav-link" %>
          <%= link_to "My Points", volunteer_points_path, class: "nav-link" %>
          <%= link_to notifications_path, class: "nav-link position-relative" do %>
            Notifications
            <% if unread_notifications_count > 0 %>
              <span class="badge rounded-pill bg-danger"><%= unread_notifications_count %></span>
            <% end %>
          <% end %>
          <%= link_to "Sign out", destroy_volunteer_session_path, data: { turbo_method: :delete }, class: "nav-link" %>
        <% elsif organizer_signed_in? %>
            <%= link_to current_organizer.name, organizer_profile_path, class: "nav-link " %>
          <%= link_to "Dashboard", organizer_dashboard_path, class: "nav-link" %>
          <%= link_to "Badges", badges_path, class: "nav-link" %>
          <%= link_to "Feedbacks", organizer_feedbacks_path, class: "nav-link" %>
          <%= link_to notifications_path, class: "nav-link position-relative" do %>
            Notifications
            <% if unread_notifications_count > 0 %>
              <span class="badge rounded-pill bg-danger"><%= unread_notifications_count %></span>
            <% end %>
          <% end %>
          <%= link_to "Sign out", destroy_organizer_session_path, data: { turbo_method: :delete }, class: "nav-link" %>
        <% else %>
          <%= link_to "Home", root_path, class: "nav-link" %>
          <%= link_to "Volunteer Sign In", new_volunteer_session_path, class: "nav-link" %>
          <%= link_to "Organizer Sign In", new_organizer_session_path, class: "nav-link" %>
        <% end %>
      </div>
    </div>
    </div>
  </nav>

  <div class="container">
    <% if notice %>
      <div class="alert alert-success"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="alert alert-danger"><%= alert %></div>
    <% end %>


    <%= yield %>
  </div>

  <footer class="text-center text-muted py-4 mt-5 border-top">
    <small>&copy; <%= Date.current.year %> Volunteer Match — Ruby on Rails Internship Project</small>
  </footer>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
