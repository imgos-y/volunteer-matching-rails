<h1>My Events</h1>

<% if @registrations.empty? %>
  <p class="empty-state">
    You haven't joined any events yet. <%= link_to "Browse events", events_path %>
  </p>
<% else %>
  <div class="card-grid">
    <% @registrations.each do |registration| %>
      <article class="panel event-card">
        <h2 class="event-card__title"><%= registration.event.name %></h2>
        <p class="event-card__meta"><%= registration.event.event_date.strftime("%d.%m.%Y") %></p>

        <div class="event-card__tags">
          <%= registration_status_tag(registration) %>
        </div>

        <% if registration.status == "registered" %>
          <% if registration.event.past? %>
            <p class="event-card__meta">Waiting for the organizer to confirm attendance.</p>
          <% else %>
            <div class="event-card__actions">
              <%= button_to "Cancel Registration", cancel_event_registration_path(event_id: registration.event.id), method: :delete, class: "button button--danger button--block" %>
            </div>
          <% end %>
        <% end %>

        <% if registration.status == "attended" %>
          <% if current_volunteer.event_feedbacks.exists?(event_id: registration.event.id) %>
            <p class="event-card__note">Thank you, your feedback has been submitted.</p>
          <% else %>
            <h3 class="form-section">Leave Feedback</h3>

            <%= form_for EventFeedback.new, url: event_event_feedbacks_path(registration.event) do |f| %>
              <div class="field">
                <%= f.label :rating %>
                <%= f.select :rating, (1..5), {}, class: "input" %>
              </div>

              <div class="field">
                <%= f.label :comment %>
                <%= f.text_area :comment, rows: 2, class: "input" %>
              </div>

              <%= f.submit "Submit Feedback", class: "button button--block" %>
            <% end %>
          <% end %>
        <% end %>
      </article>
    <% end %>
  </div>
<% end %>
