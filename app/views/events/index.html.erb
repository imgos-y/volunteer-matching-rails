<h1 class="mb-4">Events</h1>

<%= form_with url: events_path, method: :get, class: "row g-2 align-items-end mb-4" do |f| %>
  <div class="col-auto">
    <%= f.label :from, "From", class: "form-label small mb-0" %>
    <%= f.date_field :from, value: @from, class: "form-control form-control-sm" %>
  </div>
  <div class="col-auto">
    <%= f.label :to, "To", class: "form-label small mb-0" %>
    <%= f.date_field :to, value: @to, class: "form-control form-control-sm" %>
  </div>
  <div class="col-auto">
    <%= f.submit "Filter", name: nil, class: "btn btn-primary btn-sm" %>
    <%= link_to "Clear", events_path, class: "btn btn-outline-secondary btn-sm" %>
  </div>
<% end %>

<% if @events.empty? %>
  <p class="text-muted">No events found.</p>
<% end %>

<div class="row row-cols-1 row-cols-md-2 g-4">
  <% @events.each do |event| %>
    <div class="col">
      <div class="card h-100 shadow-sm">
        <div class="card-body d-flex flex-column">
          <% if volunteer_signed_in? && event.match_score_for(current_volunteer) == 2 %>
            <span class="badge bg-success mb-2 align-self-start">Best Match</span>
          <% end %>

          <h5 class="card-title"><%= event.name %></h5>
          <p class="card-text"><%= event.description %></p>

          <ul class="list-unstyled small text-muted mb-3">
            <li>📅 <%= event.event_date.strftime("%d.%m.%Y") %></li>
            <li>👥 <%= event.active_registration_count %> / <%= event.capacity %> registered</li>
          </ul>

          <div class="mb-3">
            <span class="badge bg-secondary"><%= event.skill_needed %></span>
            <span class="badge bg-info text-dark"><%= event.interest_needed %></span>
          </div>

          <div class="mt-auto">
            <% if volunteer_signed_in? %>
              <% status = @registration_statuses[event.id] %>
              <% if status == "registered" %>
                <%= button_to "Cancel Registration", cancel_event_registration_path(event_id: event.id), method: :delete, class: "btn btn-outline-danger w-100" %>
              <% elsif status == "attended" %>
                <button class="btn btn-success w-100" disabled>Attended</button>
              <% elsif status == "no_show" %>
                <button class="btn btn-outline-secondary w-100" disabled>Marked as No-Show</button>
              <% elsif event.full? %>
                <button class="btn btn-secondary w-100" disabled>Event Full</button>
              <% else %>
                <%= button_to "Join Event", event_event_registration_path(event), method: :post, class: "btn btn-primary w-100" %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>