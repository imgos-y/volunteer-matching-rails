<section class="panel panel--narrow">
  <h2 class="panel__title">Organizer Sign Up</h2>

  <%= form_with model: @organizer, url: organizers_registration_path do |f| %>
    <%= render "shared/form_errors", record: @organizer %>

    <div class="field">
      <%= f.label :name, "Organization name" %>
      <%= f.text_field :name, autofocus: true, class: "input" %>
    </div>

    <%= f.fields_for :user do |uf| %>
      <div class="field">
        <%= uf.label :email_address, "Email" %>
        <%= uf.email_field :email_address, autocomplete: "email", class: "input" %>
      </div>

      <div class="field">
        <%= uf.label :password %>
        <%= uf.password_field :password, autocomplete: "new-password", maxlength: 72, class: "input" %>
      </div>

      <div class="field">
        <%= uf.label :password_confirmation %>
        <%= uf.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72, class: "input" %>
      </div>
    <% end %>

    <%= f.submit "Sign up", class: "button button--block" %>
  <% end %>

  <div class="panel__footer">
    <%= link_to "Already have an account? Log in", new_organizers_session_path %>
  </div>
</section>
