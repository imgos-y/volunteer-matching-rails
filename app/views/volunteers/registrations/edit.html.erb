<section class="panel panel--narrow">
  <h2 class="panel__title">Edit Profile</h2>

  <%= form_with model: @volunteer, url: volunteers_registration_path do |f| %>
    <%= render "shared/form_errors", record: @volunteer %>

    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name, class: "input" %>
    </div>

    <div class="field">
      <%= f.label :surname %>
      <%= f.text_field :surname, class: "input" %>
    </div>

    <div class="field">
      <%= f.label :skill %>
      <%= f.select :skill, Volunteer::SKILLS, { prompt: "Select a skill" }, class: "input" %>
    </div>

    <div class="field">
      <%= f.label :interest %>
      <%= f.select :interest, Volunteer::INTERESTS, { prompt: "Select an interest" }, class: "input" %>
    </div>

    <h3 class="form-section">Account</h3>

    <%= f.fields_for :user do |uf| %>
      <div class="field">
        <%= uf.label :email_address, "Email" %>
        <%= uf.email_field :email_address, autocomplete: "email", class: "input" %>
      </div>

      <div class="field">
        <%= uf.label :password, "New password" %>
        <p class="field__hint" id="password-hint">Leave blank if you don't want to change it.</p>
        <%= uf.password_field :password, autocomplete: "new-password", maxlength: 72, class: "input",
                              aria: { describedby: "password-hint" } %>
      </div>

      <div class="field">
        <%= uf.label :password_confirmation, "Confirm new password" %>
        <%= uf.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72, class: "input" %>
      </div>

      <div class="field">
        <%= uf.label :password_challenge, "Current password" %>
        <p class="field__hint" id="password-challenge-hint">Only needed to change your email or password.</p>
        <%= uf.password_field :password_challenge, autocomplete: "current-password", class: "input",
                              aria: { describedby: "password-challenge-hint" } %>
      </div>
    <% end %>

    <%= f.submit "Update", class: "button button--block" %>
  <% end %>

  <div class="panel__footer">
    <%= link_to "Back to profile", volunteer_profile_path %>
  </div>
</section>
