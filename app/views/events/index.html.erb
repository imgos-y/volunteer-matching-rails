<h1>Events</h1>

<%= form_with url: events_path, method: :get, class: "filter-bar",
              data: {turbo_frame: "events", turbo_action: "advance" }  do |f| %>
  <div class="field">
    <%= f.label :from, "From" %>
    <%= f.date_field :from, value: @from, class: "input" %>
  </div>

  <div class="field">
    <%= f.label :to, "To" %>
    <%= f.date_field :to, value: @to, class: "input" %>
  </div>

  <%= f.submit "Filter", name: nil, class: "button" %>
  <%= link_to "Clear", events_path, class: "button button--secondary",
              data: {turbo_frame: "events", turbo_action: "advance"} %>
<% end %>

<%= turbo_frame_tag "events", target: "_top" do %>
<% if @events.empty? %>
  <p class="empty-state">No events found.</p>
<% end %>

<div class="card-grid">
  <% @events.each do |event| %>
    <article class="panel event-card">
      <h2 class="event-card__title"><%= event.name %></h2>
      <p class="event-card__description"><%= event.description %></p>

      <p class="event-card__meta">
        <%= event.event_date.strftime("%d.%m.%Y") %> ·
        <%= event.active_registration_count %> / <%= event.capacity %> registered
      </p>

      <div class="event-card__tags">
        <% if current_volunteer && event.match_score_for(current_volunteer) == 2 %>
          <span class="tag tag--success">Best Match</span>
        <% end %>
        <span class="tag"><%= event.skill_needed %></span>
        <span class="tag tag--primary"><%= event.interest_needed %></span>
      </div>

      <% if current_volunteer %>
        <div class="event-card__actions">
          <% status = @registration_statuses[event.id] %>
          <% if status == "registered" %>
            <%= button_to "Cancel Registration", cancel_event_registration_path(event_id: event.id), method: :delete, class: "button button--danger button--block" %>
          <% elsif status == "attended" %>
            <button class="button button--success button--block" disabled>Attended</button>
          <% elsif status == "no_show" %>
            <button class="button button--secondary button--block" disabled>Marked as No-Show</button>
          <% elsif event.full? %>
            <button class="button button--secondary button--block" disabled>Event Full</button>
          <% else %>
            <%= button_to "Join Event", event_event_registration_path(event), method: :post, class: "button button--block" %>
          <% end %>
        </div>
      <% end %>
    </article>
  <% end %>
</div>
<% end %>
