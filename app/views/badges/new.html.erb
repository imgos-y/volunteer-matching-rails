<section class="panel panel--narrow">
  <h2 class="panel__title">Create Badge</h2>

  <%= form_for @badge do |f| %>
    <%= render "shared/form_errors", record: @badge %>

    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name, class: "input" %>
    </div>

    <div class="field">
      <%= f.label :required_points %>
      <%= f.number_field :required_points, class: "input" %>
    </div>

    <%= f.submit "Create Badge", class: "button button--block" %>
  <% end %>
</section>
